# Build directories generated by CMake/Visual Studio
/build/
/build-*/
/build*/
/out/
/.vs/

# Root-level libraries produced by local builds
/lib/

# Runtime output directory.
# Keep small checked-in batch launchers, but ignore generated executables,
# resources, logs, saved editor state, and other runtime files.
/bin/*
!/bin/
!/bin/ArmadilloCollisionScene.bat
!/bin/CarScene.bat
!/bin/ClothCollisionScene.bat
!/bin/DeformableSolidCollisionScene.bat
!/bin/PileScene.bat

# CMake scratch files if users configure in the source tree
/CMakeFiles/
/CMakeCache.txt
/cmake_install.cmake

# Visual Studio / C++ build artifacts
*.obj
*.ilk
*.pdb
*.idb
*.exe
*.dll
*.lib
*.exp
*.log
*.tlog
*.lastbuildstate
*.suo
*.user
*.vcxproj.user

# Runtime/editor local state
imgui.ini
SausageRodEditorScene.json
